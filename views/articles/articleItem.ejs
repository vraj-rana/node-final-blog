<div class="card shadow mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="card-title h4 mb-0"><%= article.title %></h3>
            <span class="badge <%= article.author && article.author.role === 'admin' ? 'bg-danger' : 'bg-secondary' %>">
                <%= article.author ? article.author.role : 'user' %>
            </span>
        </div>

        <p class="text-muted small">
            By <strong><%= article.author ? article.author.username : 'Unknown' %></strong> | <%= new Date(article.createdAt).toDateString() %>
        </p>

        <hr>

        <p class="card-text" style="white-space: pre-line;"><%= article.content %></p>

        <% if (user && (article.author && (user.id == article.author._id || user.role == "admin"))) { %>
            <div class="mb-3 d-flex gap-2">
                <a href="/articles/edit/<%= article._id %>" class="btn btn-sm btn-warning">
                    Edit
                </a>
                <form action="/articles/<%= article._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this article?')">
                    <button class="btn btn-sm btn-danger">Delete</button>
                </form>
            </div>
        <% } %>

        <hr>

        <h5 class="h6 fw-bold">Comments</h5>
        <div class="comments-container mb-3">
            <% if (article.comments && article.comments.length > 0) { %>
                <% article.comments.forEach(comment => { %>
                    <% if (comment && comment.user) { %>
                        <div class="border rounded p-2 mb-2 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small text-dark"><%= comment.user.username %></span>
                                <% if (user && (user.id == comment.user._id || user.role == "admin")) { %>
                                    <form action="/comments/<%= comment._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Delete this comment?')">
                                        <button class="btn btn-sm text-danger p-0 border-0" style="text-decoration: none; font-size: 11px; background: none;">
                                            Delete
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                            <p class="mb-0 text-secondary small"><%= comment.comment %></p>
                        </div>
                    <% } %>
                <% }) %>
            <% } else { %>
                <p class="text-muted small">No comments yet.</p>
            <% } %>
        </div>

        <form action="/comments/<%= article._id %>" method="POST">
            <div class="input-group">
                <input type="text" name="comment" class="form-control form-control-sm" placeholder="Write a comment..." required>
                <button class="btn btn-sm btn-success">Comment</button>
            </div>
        </form>
    </div>
</div>
