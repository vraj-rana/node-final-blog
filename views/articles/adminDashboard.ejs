<%- include("../partials/navbar") %>

<div class="container py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="fw-bold mb-0">Admin Panel</h2>
            <p class="text-muted">Manage system users, roles, and articles</p>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2">Total Registered Users</h6>
                    <h3 class="fw-bold mb-0"><%= users.length %></h3>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase mb-2">Total Articles Published</h6>
                    <h3 class="fw-bold mb-0"><%= articles.length %></h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Users Table -->
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title fw-bold mb-0">User Database</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Articles</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-initials bg-secondary text-white rounded-circle me-2 d-flex justify-content-center align-items-center" style="width: 32px; height: 32px; font-size: 14px;">
                                                <%= user.username.charAt(0).toUpperCase() %>
                                            </div>
                                            <span class="fw-semibold"><%= user.username %></span>
                                        </div>
                                    </td>
                                    <td><%= user.email %></td>
                                    <td>
                                        <span class="badge <%= user.role === 'admin' ? 'bg-danger' : 'bg-secondary' %>">
                                            <%= user.role %>
                                        </span>
                                    </td>
                                    <td><%= user.articles ? user.articles.length : 0 %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Articles Table -->
        <div class="col-12 col-xl-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="card-title fw-bold mb-0">All System Articles</h5>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% articles.forEach(article => { %>
                                <tr>
                                    <td>
                                        <span class="fw-semibold text-truncate d-inline-block" style="max-width: 200px;">
                                            <%= article.title %>
                                        </span>
                                    </td>
                                    <td><%= article.author ? article.author.username : 'Unknown' %></td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="/articles/edit/<%= article._id %>" class="btn btn-sm btn-outline-warning">
                                                Edit
                                            </a>
                                            <form action="/articles/<%= article._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this article as Administrator?')">
                                                <button class="btn btn-sm btn-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("../partials/footer") %>
